{
  "name": "pixo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "elm"
  ],
  "scripts": {
    "db": "bun node_modules/graphile-migrate/dist/cli.js",
    "dev": "bun run --parallel types dev:*",
    "dev:proxy": "sh .scripts/neon.sh",
    "dev:vite": "bun node_modules/vite/bin/vite.js",
    "build": "bun run --sequential types:* check build:*",
    "build:vite": "vite build",
    "types": "bun run --parallel types:*",
    "types:api": "cd api && elm-ts-interop --output src/Main.elm.d.ts",
    "types:app": "elm-ts-interop --definition-dir client --output client/Main.elm.d.ts",
    "check": "bun run --parallel check:*",
    "check:api": "bun check --no-script -p api",
    "check:app": "bun check --no-script",
    "fmt": "bun run --parallel fmt:*",
    "fmt:bun": "bun fmt --no-script",
    "fmt:elm": "elm-format --yes client shared api/src tests api/tests",
    "fmt-check": "bun run --parallel --no-exit-on-error fmt-check:*",
    "fmt-check:bun": "bun fmt --no-script --check",
    "fmt-check:elm": "elm-format --validate client shared api/src tests api/tests",
    "test": "bun run --sequential test:*",
    "test:api": "cd api && elm-test",
    "test:app": "elm-test",
    "preview": "bun node_modules/vite/bin/vite.js preview"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mlc-ai/web-llm": "0.2.88",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.4",
    "bonsai-image-pipeline-lib": "github:nishlumi/bonsai-image-pipeline-lib#4afa168e0d81a8d963df46cca4505e9ee98a8a50",
    "elm": "^0.19.3-0",
    "elm-format": "^0.8.8",
    "elm-test": "^0.19.3-0",
    "elm-ts-interop": "^0.0.8",
    "graphile-migrate": "^1.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-elm": "^3.0.1"
  }
}
